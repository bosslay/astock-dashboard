 "global_news": {
  "source": "sina_7x24_global",
  "fetched_at": "2026-09-15 04:56",
  "items": [
   {
    "time": "04:50",
    "text": "市场消息：特朗普于周一致电黄仁勋，希望与黄仁勋讨论人工智能相关事宜。",
    "tags": [
     "国际"
    ]
   },
   {
    "time": "04:50",
    "text": "【特朗普称愿与伊朗谈判 提出美方要收“护航补偿”】美国总统特朗普14日在社交媒体发布多条帖文为其对伊朗政策辩护。特朗普称对与伊朗谈判持“开放”态度，并称美方在霍尔木兹海峡帮助石油运输，各国应对美进行“护航补偿”。特朗普称，伊朗“迫切”希望达",
    "tags": [
     "国际"
    ]
   },
   {
    "time": "04:48",
    "text": "美国交通部长达菲：自动化技术将进入卡车驾驶行业。预计无人机配送业务将进一步增多。人工智能将让道路上的车辆数量减少。特朗普政府正在推进AI创新。",
    "tags": [
     "国际"
    ]
   },
   {
    "time": "04:46",
    "text": "美国环境保护署废除发电厂碳污染标准，发电厂不再被强制要求安装碳捕获技术。",
    "tags": [
     "国际"
    ]
   },
   {
    "time": "04:45",
    "text": "美国交通部长达菲：计划在本届政府任期结束前更换雷达设备。",
    "tags": [
     "国际"
    ]
   },
   {
    "time": "04:38",
    "text": "特朗普： 我是骗局揭穿者，眼下我正在戳破又一个骗局 —— 人工智能将会接管、吞噬并毁灭世界，机器人会开进我们的城市，把人类全部清除！ 这甚至比通俄门骗局或全球变暖骗局还要荒谬。",
    "tags": [
     "国际"
    ]
   },
   {
    "time": "04:35",
    "text": "市场消息：加拿大总理卡尼敦促欧盟敲定贸易协定。",
    "tags": [
     "国际"
    ]
   },
   {
    "time": "04:34",
    "text": "市场消息：特朗普支持率从其总统任期最低点回升至 35%。",
    "tags": [
     "国际"
    ]
   },
   {
    "time": "04:24",
    "text": "以太坊升破2600美元，日内涨5.46%。",
    "tags": [
     "市场",
     "焦点"
    ]
   },
   {
    "time": "04:21",
    "text": "【伊朗革命卫队：一艘油轮试图穿越海峡时触雷爆炸】据伊朗法尔斯通讯社14日报道，伊朗伊斯兰革命卫队方面表示，一艘名为“阿尔加亚”的油轮试图通过霍尔木兹海峡南部“禁航区域”时，触碰水雷后爆炸起火。革命卫队称，事发后，相关方面尝试控制火势，但未能",
    "tags": [
     "国际"
    ]
   }
  ]
 },
