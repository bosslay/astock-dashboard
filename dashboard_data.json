 "global_news": {
  "source": "sina_7x24_global",
  "fetched_at": "2026-09-07 04:30",
  "items": [
   {
    "time": "04:29",
    "text": "伊朗最高国家安全委员会秘书雷扎伊：美国对伊朗及其民众的政策就是要实现完全控制，只想得到一批盲目服从命令的附庸，这就是美国一贯的诉求。",
    "tags": [
     "焦点",
     "国际"
    ]
   },
   {
    "time": "04:20",
    "text": "【泽连斯基称与美特使等人的会晤“非常具有实质性”】据乌克兰国家通讯社6日晚报道，乌克兰总统泽连斯基在与美国总统特朗普的特使威特科夫和女婿库什纳会晤后向媒体表示，乌方与美方和欧洲国家代表当天讨论了对乌越冬援助、安全保障等俄乌冲突涉及的议题，会",
    "tags": [
     "国际"
    ]
   },
   {
    "time": "04:16",
    "text": "美国特使库什纳：以色列政府在加沙问题上的行事“有些不理智”。",
    "tags": [
     "国际"
    ]
   },
   {
    "time": "04:11",
    "text": "【美一货机冲出跑道撞车起火】当地时间9月6日下午2点左右，美国亚马逊公司一架货运飞机在迈阿密国际机场冲出跑道，引发大规模紧急响应，机场暂停运营。美国联邦航空局称，这架波音767-300型货机从波多黎各的圣胡安起飞，在迈阿密国际机场着陆后冲出",
    "tags": [
     "公司",
     "国际"
    ]
   },
   {
    "time": "03:50",
    "text": "【联合国贸发会议报告：最不发达国家数字化可交付服务发展滞后】联合国贸易和发展会议近日发布最新《全球贸易更新》报告指出，服务贸易正在重塑全球贸易格局，但最不发达国家在数字贸易中日益边缘化。报告显示，过去十年，数字化可交付服务年均增长7.1%，",
    "tags": [
     "国际"
    ]
   },
   {
    "time": "03:30",
    "text": "美国交通部长达菲：应急处置人员正在迈阿密国际机场勘查现场。",
    "tags": [
     "国际"
    ]
   },
   {
    "time": "03:28",
    "text": "【美联邦航空管理局：隶属亚马逊的波音767货机在迈阿密滑出跑道】一架属于亚马逊的飞机周日在迈阿密国际机场滑出跑道。美国联邦航空管理局发布声明称：“该航班于当地时间下午2时左右在迈阿密国际机场降落之后滑出跑道。这架波音767‑300型货机从波",
    "tags": [
     "公司",
     "国际"
    ]
   },
   {
    "time": "03:27",
    "text": "美国交通部长达菲：迈阿密国际机场或将出现大规模延误，部分航班可能取消。",
    "tags": [
     "国际"
    ]
   },
   {
    "time": "03:22",
    "text": "美国联邦航空管理局：（冲出跑道的）是一架波音767-300货机，该机从波多黎各圣胡安的路易斯·穆尼奥斯·马林国际机场起飞。",
    "tags": [
     "国际"
    ]
   },
   {
    "time": "03:21",
    "text": "悉尼早盘交易中，美元兑G10货币走势涨跌互现。",
    "tags": [
     "市场"
    ]
   }
  ]
 },
