 "global_news": {
  "source": "sina_7x24_global",
  "fetched_at": "2026-09-19 04:33",
  "items": [
   {
    "time": "04:33",
    "text": "特朗普称，他儿子告诉他，会把俄罗斯人出的那份婚礼份子钱还回去。",
    "tags": [
     "国际"
    ]
   },
   {
    "time": "04:32",
    "text": "特朗普被问及小特朗普婚礼相关捐款一事时表示：这完全合规。",
    "tags": [
     "国际"
    ]
   },
   {
    "time": "04:28",
    "text": "特朗普谈肯尼迪中心：准备好解决问题了，我们有位敌对的法官。",
    "tags": [
     "国际"
    ]
   },
   {
    "time": "04:26",
    "text": "特朗普：白宫将不再陈列《纽约时报》与《华盛顿邮报》。",
    "tags": [
     "国际"
    ]
   },
   {
    "time": "04:26",
    "text": "美联储：美国上周银行存款19.657万亿美元，之前一周19.566万亿美元。",
    "tags": [
     "央行",
     "国际"
    ]
   },
   {
    "time": "04:26",
    "text": "特朗普批评《纽约时报》与《华盛顿邮报》两家媒体，称其很“恶心”。",
    "tags": [
     "国际"
    ]
   },
   {
    "time": "04:23",
    "text": "美国卫生部长肯尼迪就麻疹问题表态：呼吁民众接种疫苗。",
    "tags": [
     "国际"
    ]
   },
   {
    "time": "04:22",
    "text": "【俄国家原子能公司称库尔斯克核电站冷却塔遭袭 运行未受影响】当地时间9月18日，俄罗斯国家原子能公司通报称，17日，乌军无人机坠落在俄库尔斯克核电站二期1号机组冷却塔上时发生爆炸，造成轻微损坏。机组继续以100%功率运行，本底辐射水平正常、",
    "tags": [
     "公司",
     "国际"
    ]
   },
   {
    "time": "04:22",
    "text": "特朗普谈麻疹：相信我们会处理得很好。",
    "tags": [
     "国际"
    ]
   },
   {
    "time": "04:21",
    "text": "【大豆基金收跌1%，与地产ETF领跌美股大类资产类ETF】周五（9月18日），大豆基金收跌1.04%，美国房地产ETF跌0.96%，农产品基金跌0.95%，美国国债20+年ETF、美国布伦特油价基金、日元做多、罗素2000指数ETF、道指E",
    "tags": [
     "市场",
     "国际"
    ]
   }
  ]
 },
